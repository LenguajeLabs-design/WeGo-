# Copy to .env for local live suggestions. Never commit your real key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
PORT=4173
HOST=127.0.0.1

# Optional prototype controls
WEGO_AI_ENABLED=true
WEGO_DAILY_REQUEST_LIMIT=50
# Only set true behind a host that replaces X-Forwarded-For with the real visitor address.
WEGO_TRUST_PROXY=false
